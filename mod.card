-- Human-facing metadata: tooling and the manager's detail pane read this.
return {
  summary = "The Pokedex as a grid of pictures, each owned species in its own colours.",
  author = "MadeinTaly",
  support = "https://linktr.ee/made_in_taly",
  tags = { "pokedex", "ui", "cosmetic", "qol" },
  compat = { modApi = 2, games = { "gen1", "gen2" } },
  differences = {
    added = {
      "OW SPRITES (on by default): with Wilds of Kanto (overworld_wild_spawns) installed and enabled, the CLASSIC grid draws its per-species 16x16 overworld sprite instead of the halved battle picture, reached through mod.find rather than a manifest dependency so it changes nothing for anyone without that mod",
      "A offers DATA / CRY / AREA like the vanilla list; AREA is the engine's own LoadTownMap_Nest -- TownMap with nestSpecies -- which blinks an icon on every map whose wild slots hold the species",
      "the dex list becomes a 5x4 grid of battle pics instead of 151 rows of text",
      "every OWNED species wears its own palette, through one tile-aligned palette zone per cell -- twenty-one at once, where the Game Boy hardware could show four",
      "seen-but-uncaught species are dimmed rather than hidden, and never-met ones are blanks",
      "SELECT cycles ALL / OWNED / MISSING / SEEN ONLY, which is the fastest way to see what you are still short of",
      "GRID BIG asks the renderer for a 320x288 surface so a 56x56 battle pic draws at scale 1, undamaged",
      "on Gold, GRID BIG draws the same 320x288 grid through Gold's own widescreen contract (drawsWidescreen/drawWidescreen) instead of uiSize() -- with no per-species palette zones, since Gold colours itself and never asks a state for them",
    },
    changed = {
      "REPLACE DEX (on) points the START menu's POKeDEX row at this grid; off leaves the engine's list alone and adds a separate DEX GRID row instead",
    },
    known = {
      "runs on Pokemon Gold: the dex covers Johto, the caught half is read where Gold keeps it (`caught`, not `owned`), and DATA/AREA open Gold's own dex entry because it has no separate DexEntryMenu or TownMap",
      "on Gold, GRID BIG falls back to CLASSIC only when the window itself is too small to fit a 320x288 grid at an integer scale -- the same safety check Gen 1 already made against its own canvas -- otherwise it draws full size",
      "OW SPRITES never asks the other mod about a never-met species: its sprite would reveal a Pokemon the player has not encountered, so a blank stays a blank",
      "OW SPRITES applies in CLASSIC only -- BIG's 56-pixel cell already draws a battle picture at scale 1, and a 16-pixel sprite would have to be blown up four times to fill it",
      "the black silhouette Wilds of Kanto falls back to when it has nothing better counts as a miss, not a hit, because a silhouette in a dex grid hides which Pokemon it is and the halved picture does not",
      "A opens the engine's own DexEntryMenu rather than a copy, so ShaneMcGovernIE's Useful Dex keeps working: its stats/moves pages are one press further in",
      "CLASSIC is greyscale by necessity, not by choice -- a 28-pixel cell is three and a half tiles and a palette zone is addressed in tiles",
      "the pictures are the ROM's own art and cannot be redrawn, so the larger surface buys room and colour, never more detail",
      "a sprite pack that shadows Assets.image is honoured: the scale is derived from the picture handed over, in whole steps, so a 112x112 replacement does not draw over its neighbours",
    },
  },
}
